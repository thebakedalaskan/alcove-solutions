{
  "name": "@alcove/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "migrate": "tsx --env-file=../../.env src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "esbuild src/server.ts src/migrate-cli.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --sourcemap --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "start:prod": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@alcove/api": "workspace:*",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alcove/api-http": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vite": "^8.3.5",
    "esbuild": "^0.28.2"
  }
}