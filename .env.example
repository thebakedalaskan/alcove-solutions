DATABASE_URL=postgres://alcove:alcove@127.0.0.1:54329/alcove
TEST_DATABASE_URL=postgres://alcove:alcove@127.0.0.1:54329/alcove_test
# How long the API keeps trying to reach its database when it starts, in ms, if not 180000, before it refuses to start.
# DATABASE_WAIT_MS=180000
OBJECTS_ENDPOINT=http://127.0.0.1:9310
OBJECTS_BUCKET=alcove-objects
OBJECTS_ACCESS_KEY=alcove
OBJECTS_SECRET_KEY=alcove-local-secret
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
# The API as browsers reach it: here the web app's dev proxy; in production e.g. https://api.alcove.solutions.
API_URL=http://localhost:3000/api
# Sign-in with Google and Google Calendar (a Web OAuth client). Register $API_URL/v1/auth/google/callback as a
# redirect URI. Drive exports also need $API_URL/v1/drive/callback, the Drive and Picker APIs enabled,
# and drive.file declared on the consent screen. Left empty, Google connections explain that they aren't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local sign-up defaults to open. Testers mode requires an approved verified email. Public mode requires Gmail
# or a verified Google Workspace identity for new accounts and email changes.
# GOOGLE_SIGNUP_MODE=testers
# GOOGLE_SIGNUP_TESTERS=person@example.com
# Demo sign-in is enabled for local development. The public beta disables it in both the API and web build.
# DEMO_AUTH_ENABLED=false
# VITE_ALCOVE_DEMO_AUTH_ENABLED=false
# Hosts sign-in photos may come from. Alcove fetches them itself, so browsers never ask Google for anyone's face.
# PHOTO_HOSTS=googleusercontent.com
# Two keys, each 32 random bytes in base64url. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# KMASTER wraps every account's root key (production: only inside the confidential VM).
KMASTER=
# KSERVICE seals billing state.
KSERVICE=
# Inside Google Cloud Confidential Space (Intel TDX), the master key is made there and kept wrapped by Cloud KMS, and
# seals the others in the database; the API refuses to start with KMASTER or KSERVICE set. Once every account made
# under the old keys has moved to it, RETIRE_LEGACY_KMASTER=true forgets the old master; it's refused outside a TEE.
# TEE=confidential-space
# RETIRE_LEGACY_KMASTER=false
# Inside the TEE, Google Cloud is reached as the identity its attestation is exchanged for: the project whose Secret Manager
# holds the secrets, the Cloud KMS key that wraps the master, and the Workload Identity Federation provider. SECRETS names
# the settings that are secrets (ENV_NAME=secret-name, comma-separated), each read from Secret Manager at start and never
# put in the environment: only DATABASE_URL, OBJECTS_ACCESS_KEY, OBJECTS_SECRET_KEY, LIVEKIT_API_KEY, LIVEKIT_API_SECRET,
# NEAR_AI_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_SIGNUP_TESTERS and CLOUDFLARE_API_TOKEN may be.
# LEGACY_SECRETS names the secrets holding the old KMASTER and KSERVICE: the old master is used only while it's set, until
# it's retired.
# All of them are refused outside a TEE.
# GCP_PROJECT=alcove-solutions
# KMS_MASTER_KEY=projects/alcove-solutions/locations/us-central1/keyRings/alcove/cryptoKeys/alcove-master
# WIF_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/alcove/providers/confidential-space
# SECRETS=DATABASE_URL=alcove-database-url,CLOUDFLARE_API_TOKEN=alcove-cloudflare-api-token
# LEGACY_SECRETS=alcove-kmaster,alcove-kservice
# TLS ending in the API itself (required inside a TEE): the hosts its one certificate names (api. hosts are the API, www.
# ones are sent on to the host without it, the rest serve the web app's files from WEB_DIR), HTTPS on HTTPS_PORT behind a
# load balancer that adds a PROXY protocol line, and plain HTTP on HTTP_PORT for /health and redirects. Certificates come
# from ACME_DIRECTORY (Let's Encrypt's by default) through dns-01 in a Cloudflare zone, its ID or name, with a token that
# can edit its DNS (a secret: inside a TEE, through SECRETS).
# TLS_HOSTS=alcove.solutions,www.alcove.solutions,api.alcove.solutions
# HTTPS_PORT=8443
# HTTP_PORT=8080
# WEB_DIR=/app/web
# ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# CLOUDFLARE_ZONE=
# CLOUDFLARE_API_TOKEN=
# Switching feature flags through the API (POST /v1/operator/feature-flags): the SHA-256, as 64 lowercase hex characters,
# of the token operators send. Left empty, that route isn't there (docs/engineering/feature-flags.md › In production).
# OPERATOR_TOKEN_SHA256=
# LiveKit (group calls): the local server from docker-compose.yml (infra/livekit/dev.yaml), or wss://<project>.livekit.cloud.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-0123
# NEAR AI Cloud: the live transcript and written notes. Left empty, recordings are kept but not
# transcribed, and their notes wait for the notes service.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# The models, if not these defaults: speech to text, and the model that writes notes and answers questions.
# NEAR_AI_STT_MODEL=openai/whisper-large-v3
# NEAR_AI_NOTES_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Nothing is sent to a model until its evidence checks out. If not these defaults: the models' own endpoints
# (requests go to their /ohttp, sealed to their attested keys), Intel's certification service and NVIDIA's
# attestation service. The roots evidence must chain to are built in (apps/api/src/roots.ts); tests set
# their own with INTEL_ROOT_CA and NVIDIA_ROOT_CA. Inside a TEE only the built-in roots and services are taken.
# NEAR_AI_STT_URL=https://whisper-large-v3.completions.near.ai
# NEAR_AI_NOTES_URL=https://deepseek-v4-1-flash.completions.near.ai
# Where the other models that can read shared screens are served (the registry of NEAR AI's own endpoints).
# NEAR_AI_ENDPOINTS_URL=https://completions.near.ai/endpoints
# INTEL_PCS_URL=https://api.trustedservices.intel.com
# NVIDIA_NRAS_URL=https://nras.attestation.nvidia.com
# How long a browser's stream of rings lasts, at most, in seconds, if not 240. Under Cloud Run's request timeout.
# RING_STREAM_SECONDS=240
# Live streams: how often they ping and check who's reading, how long before the API lets go and the browser opens them
# again, and how long someone stays here after their browser last said so, in ms, if not these defaults. Keep the second
# under whatever times out requests in front of the API, and the third over the 10 seconds browsers say it in.
# LIVE_PING_MS=25000
# LIVE_STREAM_MS=280000
# How often each API instance checks its LISTEN connection is alive, and how long that connection has to answer, in ms.
# HUB_CHECK_MS=15000
# HUB_TIMEOUT_MS=5000
# LIVE_PRESENCE_MS=30000
# The most workspace and document streams an instance holds, everyone's together, if not 500, and from one address, if not
# 64. Each holds a request for as long as it's open, as do up to 300 streams of rings, and calls need what's left of what the
# instance takes at once.
# LIVE_STREAMS_MAX=500
# LIVE_STREAMS_PER_ADDRESS=64
# How long one of someone's streams has been open, in ms, before it can end to make room for another of theirs at their limit,
# and how often room is made for them at most.
# LIVE_MAKE_ROOM_MS=20000
# Workers opening documents: how many, how long each job has in ms, how much memory the one for big documents has in MiB,
# the most separate items a document's page can hold (which is what its memory follows), how many jobs one person can have
# waiting, how much of documents in MiB can be on its way to browsers (a quarter of it for one person or one address), and reads
# of a version at once.
# DOC_WORKERS=2
# DOC_WORK_MS=20000
# DOC_HEAP_MB=640
# DOC_ITEMS_MAX=150000
# DOC_WAITING_PER_PERSON=32
# DOC_SENDING_MB=64
# DOC_VERSION_READS=8
# Credit top-ups through NEAR Intents 1Click: the NEAR account whose Intents balance receives every payment and
# refund (left empty, top-ups are off), and optionally the partner JWT from partners.near-intents.org, which lowers
# 1Click's fee.
ONECLICK_API_KEY=
TREASURY_INTENTS_ACCOUNT=
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Logging: debug | info | warn | error | silent, and pretty (terminal) or json (log collectors)
LOG_LEVEL=info
LOG_FORMAT=pretty
