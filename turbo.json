{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "OBJECTS_ENDPOINT",
    "OBJECTS_BUCKET",
    "OBJECTS_ACCESS_KEY",
    "OBJECTS_SECRET_KEY",
    "API_PORT",
    "WEB_ORIGIN",
    "API_URL",
    "GOOGLE_API_URL",
    "GOOGLE_ISSUER",
    "KSERVICE",
    "LIVEKIT_URL",
    "LIVEKIT_API_URL",
    "CALL_MAX_PARTICIPANTS",
    "CALL_TOKEN_TTL_SECONDS",
    "NEAR_AI_BASE_URL",
    "NEAR_AI_STT_MODEL",
    "NEAR_AI_NOTES_MODEL",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "TEST_LOGS"
  ],
  "globalPassThroughEnv": [
    "KMASTER",
    "NEAR_AI_API_KEY",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET"
  ]
}
